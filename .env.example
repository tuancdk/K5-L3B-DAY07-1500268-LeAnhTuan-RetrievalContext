# Day 6 pgvector, started by `docker compose -p day7_retrieval up -d` (host port 15433)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:15433/day6_lab
# Must match the Day 6 index: text-embedding-3-small, 1536 dims
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Optional: path to the Day 6 repo (benchmark + ingest report); default is ../../VinUni-Day6/<repo>
DAY6_DIR=
